# Source this file for configuration of this repository.

OWDB_IMAGE_ROOT=billybag2/open-wrt-docker-build
OWDB_IMAGE=${OWDB_IMAGE_ROOT}:latest
OWDB_SECRETS_FILE=secrets/secret.env

if [ -f ${OWDB_SECRETS_FILE} ]; then
    source ${OWDB_SECRETS_FILE}
else
    echo "Secrets file ${OWDB_SECRETS_FILE} not found. Please create it and add the necessary secrets."
    exit 1
fi
